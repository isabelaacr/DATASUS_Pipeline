+def remover_notificacoes_duplicadas(notificacoes: pd.DataFrame) -> pd.DataFrame:
+    """Mesma pessoa (ano de nascimento, sexo, município) com a mesma data de primeiros sintomas é a mesma
+    notificação, venha ela repetida no arquivo (preliminar e final) ou renotificada. Fica a mais completa."""
