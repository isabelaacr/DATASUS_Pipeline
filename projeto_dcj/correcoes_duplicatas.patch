+    numero = Bruto.OBITO_NUMERO_DA_DECLARACAO
+    identificador = (normalizar_identificador(tabela[numero]) if numero in tabela.columns
+                     else pd.Series(pd.NA, index=tabela.index, dtype="string"))
+    return chave, identificador
