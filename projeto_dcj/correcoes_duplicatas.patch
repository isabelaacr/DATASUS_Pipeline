+    informacao = notificacoes[[Col.DATA_OBITO_NOTIFICADA, Col.CLASSIFICACAO_FINAL]].notna().sum(axis=1)
+    ordenadas = notificacoes.assign(_informacao=informacao).sort_values("_informacao", ascending=False, kind="stable")
+    unicas = ordenadas.drop_duplicates(subset=chave).drop(columns="_informacao").sort_index()
+    if len(unicas) < len(notificacoes):
