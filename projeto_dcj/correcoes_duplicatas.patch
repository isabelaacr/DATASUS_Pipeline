+    padrao = {Bruto.OBITO_MUNICIPIO: "431490", Bruto.OBITO_SEXO: "1", Bruto.OBITO_NASCIMENTO: "01021950",
+              Bruto.OBITO_DATA: "15032019", Bruto.OBITO_CAUSA: "F03", Bruto.OBITO_IDADE: "469"}
+    return pd.DataFrame([{**padrao, **linha} for linha in linhas])
+
+
+def test_identificador_ignora_formatacao():
+    valores = pd.Series(["0012345", "12345.0", " 12345 ", "", None])
+    assert normalizar_identificador(valores).tolist()[:3] == ["12345"] * 3
+    assert normalizar_identificador(valores).isna().tolist()[3:] == [True, True]
+
+
+def test_mesma_declaracao_com_formatos_diferentes_e_removida():
+    # estadual x consolidado nacional: CID com ponto e minúscula, NUMERODO com zeros à esquerda
+    tabela = obitos_brutos({Bruto.OBITO_NUMERO_DA_DECLARACAO: "0099887766"},
+                           {Bruto.OBITO_NUMERO_DA_DECLARACAO: "99887766", Bruto.OBITO_CAUSA: "f03"})
+    assert len(remover_duplicatas(tabela, chave_dos_obitos)) == 1
+
+
+def test_sem_numerodo_usa_chave_normalizada():
+    tabela = obitos_brutos({}, {Bruto.OBITO_CAUSA: "F03 "}, {Bruto.OBITO_DATA: "16032019"})
+    assert len(remover_duplicatas(tabela, chave_dos_obitos)) == 2  # o terceiro morreu em outro dia
+
+
+def test_linha_sem_numerodo_igual_a_uma_com_numerodo_e_removida():
+    tabela = obitos_brutos({Bruto.OBITO_NUMERO_DA_DECLARACAO: "123"}, {Bruto.OBITO_NUMERO_DA_DECLARACAO: None})
+    assert len(remover_duplicatas(tabela, chave_dos_obitos)) == 1
+
+
