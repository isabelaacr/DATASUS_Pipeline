+        "diagnostico": padronizar_cid(tabela[Bruto.INTERNACAO_DIAGNOSTICO]),
+    }, index=tabela.index)
+    numero = Bruto.INTERNACAO_NUMERO_DA_AIH
+    identificador = (normalizar_identificador(tabela[numero]) if numero in tabela.columns
